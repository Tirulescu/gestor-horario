# Supabase Auth (cliente + SSR)
NEXT_PUBLIC_SUPABASE_URL=https://nxczxcmwqnnvdfilsxfe.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Desarrollo local: origen para OAuth (debe coincidir con Redirect URLs en Supabase)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Conexión directa PostgreSQL para Drizzle (server-side API routes)
# Dashboard → Project Settings → Database → Connection string (Session pooler)
DATABASE_URL=

# Google OAuth — NO los usa Next.js directamente; pégalos en:
# Supabase Dashboard → Authentication → Providers → Google
# Créalos en: https://console.cloud.google.com/apis/credentials
# Redirect URI en Google: https://nxczxcmwqnnvdfilsxfe.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
